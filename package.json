  "dependencies": {
    "@expo/ui": "~57.0.15",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.19",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --go --android --clear",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "start:go": "expo start --go --clear",
    "start:dev": "expo start --dev-client --clear",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\VERIFY.ps1",
    "verify:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\VERIFY_RELEASE.ps1",
    "audit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\AUDIT_PLAN_1_1.ps1",
    "build:preview": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\BUILD_ANDROID.ps1 -Profile preview",
    "build:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\BUILD_ANDROID.ps1 -Profile production",
    "submit:internal": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\SUBMIT_ANDROID.ps1 -Track internal",
    "submit:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\SUBMIT_ANDROID.ps1 -Track production"
  },
  "private": true
}
