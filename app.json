{
  "expo": {
    "name": "Peque\u00f1as Finanzas",
    "slug": "pequenas-finanzas",
    "scheme": "pequenasfinanzas",
    "version": "0.1.1",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0DE"
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pequenasfinanzas.app"
    },
    "android": {
      "package": "com.pequenasfinanzas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#18452C"
      },
      "versionCode": 1,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "icon": "./assets/app/icon.png",
    "web": {
      "favicon": "./assets/app/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "276b4c9a-4ba5-4366-b3e4-219c89fad343"
      }
    },
    "owner": "jjcc2000"
  }
}
